{
  "schemaVersion": 1,
  "id": "mobwalk",
  "version": "${version}",
  "name": "MobWalk",
  "description": "Shows where a chosen mob can stand and walk, marking inescapable holes, and hazards like lava and soul sand.",
  "authors": [
    "kelianmao"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/mobwalk",
    "sources": "https://github.com/kelianmao/mobwalk"
  },
  "license": "MIT",
  "icon": "assets/mobwalk/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.kelianmao.mobwalk.client.MobWalkClient"
    ],
    "modmenu": [
      "dev.kelianmao.mobwalk.client.config.MobWalkModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "malilib": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
